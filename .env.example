# 이름만 둔다. 값은 각 워크스테이션의 .env 에만 쓴다 (커밋 금지).
# 호스트·포트·키·홈 경로는 코드와 문서에 쓰지 않는다 (요구사항서 2장).

# ── 호스트 ──
EDIT_HOST=
GEN_HOST=
EDIT_PORT=
INPAINT_PORT=

# ── 경로 ──
# TRELLIS / VoxHammer 체크포인트와 HF 캐시
HF_HOME=
# 기준 구현 빌드 위치 (기본 build/reference)
REFERENCE_DIR=
# 실행 산출물(계측 JSON, 렌더, slat_tgt) 저장 위치
RUNS_DIR=
# 대상 자산·마스크·조건 이미지 위치
ASSETS_DIR=
# Blender 실행 파일
BLENDER_BIN=

# ── 파이썬 실행 파일 (러너가 사용) ──
A5000_PYTHON=
RTX3090_PYTHON=

# ── 기준 실행 시 반드시 비워 둔다 ──
W39_ATTN_MASK=

# ── 항목별 토글 (각 항목 구현 시 추가, 기본 0) ──
# VHL_E2A_STEPS_S1=25
# VHL_E2A_STEPS_S2=25
