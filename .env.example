# 각 워크스테이션의 .env 로 복사해 쓴다. 토큰·비밀번호 값만 커밋하지 않는다.

# ── 호스트 ──
EDIT_HOST=
GEN_HOST=
# A5000 편집·렌더 워커 (3090 → A5000 LAN 접속)
EDIT_PORT=8082
# 3090 인페인팅 워커 (localhost 바인딩)
INPAINT_PORT=8082

# ── 경로 ──
# TRELLIS / VoxHammer 체크포인트와 HF 캐시
HF_HOME=
# 원본 FLUX.1-Fill-dev 다운로드용 (계정 rockthepeople). 값은 고객사가 장비에 직접 설정
HF_TOKEN=
# 기준 구현 빌드 위치
REFERENCE_DIR=build/reference-v2
# 실행 산출물(계측 JSON, 렌더, slat_tgt) 저장 위치
RUNS_DIR=
# 대상 자산·마스크·조건 이미지 위치
ASSETS_DIR=
# Blender 실행 파일
BLENDER_BIN=

# ── 파이썬 실행 파일 (러너가 사용) ──
A5000_PYTHON=
RTX3090_PYTHON=

# ── 기준 실행 시 반드시 비워 둔다 ──
W39_ATTN_MASK=

# ── 항목별 토글 (각 항목 구현 시 추가, 기본 0) ──
# VHL_E2A_STEPS_S1=25
# VHL_E2A_STEPS_S2=25
